<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= recipe.name %> 레시피</title>
    <style>
        /* 기본 스타일 */
        body {
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
            color: #333;
        }

        /* 헤더 */
        header {
            background-color: #f9c0b5;
            color: white;
            padding: 25px 15px;
            position: relative;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header img {
            width: 150px;
            height: auto;
            cursor: pointer;
        }

        .right-nav-icons {
            display: flex;
            gap: 15px;
        }

        .right-nav-icons a {
            display: block;
            width: 40px;
            height: 40px;
        }

        .right-nav-icons img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
            transition: transform 0.3s ease;
        }

        .right-nav-icons img:hover {
            transform: scale(1.1);
        }

        nav {
            background-color: #333;
            color: white;
            padding: 10px 0;
            text-align: center;
        }

        nav a {
            color: white;
            margin: 0 20px;
            text-decoration: none;
            font-size: 1.1em;
        }

        nav a:hover {
            color: #ff6347;
        }

        #tabs {
            display: flex;
            justify-content: center;
            gap: 20px;
            background-color: #333;
            padding: 15px 0;
        }

        #tabs a {
            padding: 12px 30px;
            background-color: #555;
            color: white;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 600;
            text-transform: uppercase;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        #tabs a:hover {
            background-color: #ff6347;
            color: white;
        }

        #tabs a.active {
            background-color: #ff6347;
            color: white;
        }

        main.container {
            width: 90%;
            margin: 30px auto;
            max-width: 1200px;
        }

        .recipe-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            background-color: white;
            padding: 20px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
        }

        .recipe-header img {
            width: 400px;
            height: 300px;
            object-fit: cover;
            border-radius: 8px;
        }

        .recipe-details {
            width: 60%;
            margin-left: 30px;
            font-size: 1.1em;
            color: #555;
        }

        .recipe-details h2 {
            font-size: 2em;
            color: #333;
            margin-bottom: 15px;
        }

        .ingredients, .instructions, .difficulty-time {
            margin-bottom: 20px;
        }

        .ingredients ul, .instructions ul {
            list-style-type: none;
            padding: 0;
        }

        .ingredients li, .instructions li {
            margin-bottom: 10px;
        }

        .favorite-icon {
            background-color: #ff6347;
            border: none;
            color: white;
            padding: 12px 20px;
            border-radius: 25px;
            cursor: pointer;
            font-size: 1em;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background-color 0.3s;
        }

        .favorite-icon:hover {
            background-color: #ff4500;
        }

        .favorite-icon:before {
            content: '❤️';
            margin-right: 10px;
        }

        footer {
            background-color: #333;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 50px;
        }

        .social-icons {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 20px;
        }

        .social-icons a {
            display: block;
            color: white;
            text-decoration: none;
        }

        .social-icons img {
            width: 40px;
            height: 40px;
            transition: transform 0.3s ease;
        }

        .social-icons img:hover {
            transform: scale(1.1);
        }

        @media (max-width: 768px) {
            header {
                flex-direction: column;
                align-items: center;
                padding: 20px;
            }

            header img {
                width: 120px;
            }

            .recipe-header {
                flex-direction: column;
                align-items: center;
                padding: 20px;
            }

            .recipe-header img {
                width: 100%;
                height: auto;
                margin-bottom: 20px;
            }

            .recipe-details {
                width: 100%;
                margin-left: 0;
            }

            .favorite-icon {
                padding: 10px 18px;
                font-size: 1.1em;
            }

            .social-icons img {
                width: 35px;
                height: 35px;
            }
        }
    </style>
</head>
<body>
    <!-- 헤더 -->
    <header>
        <a href="main.html">
            <img src="로고.jpg" alt="Logo">
        </a>

        <div class="right-nav-icons">
            <a href="favorite.html" title="즐겨찾기">
                <img src="즐겨찾기.png" alt="즐겨찾기">
            </a>
            <a href="signup.html" title="회원가입">
                <img src="회원가입.png" alt="회원가입">
            </a>
            <a href="profile.html" title="프로필">
                <img src="로그인.png" alt="프로필">
            </a>
            <a href="community.html" title="커뮤니티">
                <img src="커뮤니티.png" alt="커뮤니티">
            </a>
        </div>
    </header>

    <div id="tabs">
        <a href="best.html" class="tab-button">BEST</a>
        <a href="new.html" class="tab-button">NEW</a>
        <a href="vegetarian.html" class="tab-button">VEGETARIAN</a>
        <a href="meat.html" class="tab-button active">MEAT</a>
    </div>

    <main class="container">
        <div class="recipe-header">
            <!-- 레시피 이미지 -->
            <img src="<%= recipe.image_url ? '/uploads/' + recipe.image_url : '/default.jpg' %>" alt="<%= recipe.name %>">
            <div class="recipe-details">
                <h2><%= recipe.name %></h2>
                <p><%= recipe.description %></p>

                <div class="ingredients">
                    <h3>재료</h3>
                    <ul>
                        <% ingredients.forEach(function(ingredient) { %>
                            <li><%= ingredient.name %></li>
                        <% }); %>
                    </ul>
                </div>

                <div class="instructions">
                    <h3>조리 방법</h3>
                    <ul>
                        <% recipe.steps.split('\n').forEach(function(step) { %>
                            <li><%= step %></li>
                        <% }); %>
                    </ul>
                </div>

                <div class="difficulty-time">
                    <p><strong>난이도:</strong> <%= recipe.difficulty %></p>
                    <p><strong>제작 시간:</strong> <%= recipe.total_time %> 분</p>
                </div>

                <button class="favorite-icon">
                    <span>즐겨찾기</span>
                </button>
            </div>
        </div>
    </main>

    <footer>
        <p>&copy; 2024 Your Company. All Rights Reserved.</p>
        <div class="social-icons">
            <a href="https://www.instagram.com/" title="Instagram"><img src="instagram.png" alt="Instagram"></a>
            <a href="https://www.youtube.com/" title="Youtube"><img src="youtube.png" alt="Youtube"></a>
            <a href="https://www.blog.com/" title="Blog"><img src="blog.png" alt="Blog"></a>
        </div>
    </footer>
</body>
</html>

